{
	"info": {
		"_postman_id": "ueapd-api-collection-grupo9",
		"name": "UEAPD Gestión Académica API REST",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Salud y Diagnóstico",
			"item": [
				{
					"name": "GET Health Check",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
					}
				},
				{
					"name": "GET Ready Check DB",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/ready", "host": ["{{base_url}}"], "path": ["ready"] }
					}
				}
			]
		},
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "POST Login Admin",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
						},
						"url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
					}
				},
				{
					"name": "POST Login Alumno",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"alumno1\",\n  \"password\": \"alumno123\"\n}"
						},
						"url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
					}
				}
			]
		},
		{
			"name": "Calificaciones",
			"item": [
				{
					"name": "GET Calificaciones Alumno",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/grades/student", "host": ["{{base_url}}"], "path": ["grades", "student"] }
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://localhost/gestion_academica/api/v1" },
		{ "key": "jwt_token", "value": "" }
	]
}
